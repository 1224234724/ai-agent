# 复制为 .env 后填写（勿提交真实密钥）
NODE_ENV=production

# OpenAI 兼容接口（如 DeepSeek）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# JWT 签名密钥（生产必须更换；更换后需重算 data/users.json 密码哈希）
JWT_SECRET=change-me-to-a-long-random-string

# 登录 Cookie 的 Secure 属性：默认生产环境开启（需 HTTPS）；纯 HTTP 部署设为 false
# COOKIE_SECURE=false

# MySQL 连接（库名默认 ai_agent，首次启动自动建表并迁移旧 JSON 数据）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=ai_agent

# 可选：本地/服务器 compose 镜像名覆盖
# IMAGE_NAME=ghcr.io/your-org/ai-agent:latest
# APP_PORT=3000
