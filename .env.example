# 复制为 .env 后填写（勿提交真实密钥）
NODE_ENV=production

# OpenAI 兼容接口（如 DeepSeek）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# JWT 签名密钥（生产必须更换；更换后需重算 data/users.json 密码哈希）
JWT_SECRET=change-me-to-a-long-random-string

# 可选：本地/服务器 compose 镜像名覆盖
# IMAGE_NAME=ghcr.io/your-org/ai-agent:latest
# APP_PORT=3000
